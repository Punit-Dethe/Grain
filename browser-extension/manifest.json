{
  "manifest_version": 3,
  "name": "Grain Pilot",
  "version": "0.1.0",
  "description": "Lets Grain's Agent open pages and act in tabs it opens, signed in as you.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "worker.js", "type": "module" },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"]
}
