# [GRAIN] Updater signing keys — NEVER commit these. The real keypair lives
# outside the repo (~/.grain-keys); these patterns are a safety net.
.grain-keys/
*.updater.key
*.updater.key.pub
*.updater.key.password
grain.updater.key*

# Keep private keys out of source control, including files from retired tooling.
registry-keys/
production-keys/
*.key

# Reference projects
Refrence/

# Python bytecode from the Upstream/ tooling
__pycache__/
*.pyc

# Upstream tracker build products. Rebuilt on every sync from upstream's commit
# list, our git ancestry, and Upstream/verdicts.json — the only file a human
# owns. Committing them put a bot commit in main every 2 hours. See
# Upstream/UPSTREAM.md.
Upstream/data.json
Upstream/merge-report.md

# Local planning documents
docs/
# Public release notes are versioned and read by the Windows release workflow.
!docs/
docs/*
!docs/releases/

# Persistent Agent harness definitions are versioned; builds/runs are disposable.
/tests/agent-harness/.build/
/tests/agent-harness/.runs/

# Keep separately cloned publisher checkouts out of this repository.
grain-extensions/
# transcribe.cpp source fork: independent repository, co-located for development.
/native/transcribe.cpp/
# Python bytecode (scripts/)
__pycache__/

# Website repository (separate git repo)
website/

